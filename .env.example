# Port, unter dem Make:Log im lokalen Netzwerk erreichbar ist.
MAKELOG_PORT=8080

# Bind-Adresse. Für einen Reverse Proxy auf demselben Host 127.0.0.1 verwenden.
MAKELOG_BIND_ADDRESS=0.0.0.0

# Zeitzone des Containers. In Make:Log selbst wird sie beim Setup gewählt.
MAKELOG_TIMEZONE=Europe/Berlin

# Wird vom optionalen Docker-Update-Helfer automatisch auf einen geprüften
# GHCR-Digest gesetzt. Für lokale Builds kann der Standard unverändert bleiben.
MAKELOG_IMAGE=makelog:local
