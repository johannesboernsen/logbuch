# Port, unter dem das Logbuch im lokalen Netzwerk erreichbar ist.
LOGBUCH_PORT=8080

# Bind-Adresse. Für einen Reverse Proxy auf demselben Host 127.0.0.1 verwenden.
LOGBUCH_BIND_ADDRESS=0.0.0.0

# Zeitzone der Container. Im Logbuch selbst wird sie beim Setup gewählt.
LOGBUCH_TIMEZONE=Europe/Berlin

# Offizielle Images. Der AIO-Updater pinnt beide nach jeder Prüfung auf einen Digest.
LOGBUCH_IMAGE=ghcr.io/johannesboernsen/logbuch:stable
LOGBUCH_UPDATER_IMAGE=ghcr.io/johannesboernsen/logbuch-updater:stable
LOGBUCH_UPDATE_IMAGE=ghcr.io/johannesboernsen/logbuch
LOGBUCH_UPDATE_UPDATER_IMAGE=ghcr.io/johannesboernsen/logbuch-updater
LOGBUCH_UPDATE_POLL_SECONDS=5
